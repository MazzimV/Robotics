<?xml version="1.0"?>
<launch>
  <!-- Launch the lane follower node -->
  <node pkg="autonomous_navigation" type="lane_follower.py" name="lane_follower" output="screen">
    <!-- ROI parameters -->
    <param name="roi_top_ratio" value="0.5" />
    <param name="roi_bottom_ratio" value="0.95" />
    <param name="roi_width_ratio" value="0.9" />
    
    <!-- Control parameters -->
    <param name="max_speed" value="0.3" />
    <param name="min_speed" value="0.1" />
    <param name="max_angle" value="0.8" />
    
    <!-- PID controller parameters -->
    <param name="kp" value="0.8" />
    <param name="ki" value="0.01" />
    <param name="kd" value="0.2" />
  </node>
  
  <!-- Launch RViz for visualization -->
  <node pkg="rviz" type="rviz" name="rviz" args="-d $(find lane_follower)/rviz/lane_following.rviz" />
  
  <!-- Launch rqt_image_view for debug image -->
  <node pkg="rqt_image_view" type="rqt_image_view" name="image_view" args="/lane_debug" />
</launch>